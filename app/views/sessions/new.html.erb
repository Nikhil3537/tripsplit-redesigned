<% content_for :title, "Login — TripSplit" %>

<div class="container ts-shell ts-auth-wrap">
  <div class="row justify-content-center w-100 g-0">
    <div class="col-12 col-lg-10 col-xl-9">
      <div class="ts-auth-card row g-0 ts-fade-in">

        <div class="col-lg-5 d-none d-lg-flex ts-auth-side">
          <div class="ts-auth-side-content d-flex flex-column justify-content-between">
            <div>
              <span class="ts-brand text-white mb-4 d-inline-flex">
                <span class="ts-brand-mark bg-white bg-opacity-25"><i class="bi bi-wallet2"></i></span>
                <span>TripSplit</span>
              </span>
              <h2 class="text-white fw-bold mb-3">Welcome back.</h2>
              <p class="text-white-50">Log in to see your trips, track shared expenses, and settle up with your group in seconds.</p>
            </div>
            <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> Fair, automatic expense splitting
              </li>
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> Real-time balances for every member
              </li>
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> One-tap settlement tracking
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="ts-auth-form">
            <div class="mb-4">
              <h3 class="fw-bold mb-1">Log in to your account</h3>
              <p class="text-muted mb-0">Enter your details to continue.</p>
            </div>

            <%= form_with url: session_path do |form| %>

              <%= hidden_field_tag :join_token, session[:join_token] %>

              <div class="mb-3">
                <%= form.label :email, class: "form-label" %>
                <div class="ts-input-group">
                  <i class="bi bi-envelope ts-input-icon"></i>
                  <%= form.email_field :email, class: "form-control", placeholder: "you@example.com", required: true, autofocus: true %>
                </div>
              </div>

              <div class="mb-3">
                <%= form.label :password, class: "form-label" %>
                <div class="ts-input-group">
                  <i class="bi bi-lock ts-input-icon"></i>
                  <%= form.password_field :password, class: "form-control", placeholder: "••••••••", required: true, id: "session_password" %>
                  <button type="button" class="ts-toggle-password" data-ts-toggle-password="#session_password" tabindex="-1" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <div class="d-grid mt-4">
                <%= form.submit "Log In", class: "btn btn-primary btn-lg" %>
              </div>

            <% end %>

            <p class="text-center text-muted mt-4 mb-0">
              Don't have an account?
              <%= link_to "Create one", new_user_path, class: "fw-bold text-decoration-none" %>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
