<% content_for :title, "My Trips — TripSplit" %>

<div class="container ts-shell ts-page">

  <div class="ts-page-header">
    <div>
      <p class="ts-eyebrow">TripSplit</p>
      <h1 class="ts-page-title">My Trips</h1>
      <p class="ts-page-subtitle">Signed in as <strong><%= current_user.name %></strong> — <%= pluralize(@trips.count, "trip") %> total.</p>
    </div>
    <%= link_to new_trip_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> New Trip
    <% end %>
  </div>

  <% if @trips.any? %>
    <div class="row g-4">
      <% @trips.each do |trip| %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="ts-trip-card">
            <div class="ts-trip-banner">
              <i class="bi bi-airplane-fill ts-trip-icon"></i>
              <span class="badge rounded-pill <%= trip.active? ? 'bg-success' : (trip.ended? ? 'bg-secondary' : 'bg-dark') %>">
                <%= trip.status.capitalize %>
              </span>
            </div>
            <div class="ts-trip-body">
              <h5 class="fw-bold mb-1"><%= trip.name %></h5>
              <p class="text-muted small mb-3">
                <i class="bi bi-geo-alt me-1"></i><%= trip.destination.presence || "No destination set" %>
              </p>

              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="small text-muted">
                  <i class="bi bi-calendar3 me-1"></i>
                  <%= trip.start_date&.strftime("%b %d") %> – <%= trip.end_date&.strftime("%b %d, %Y") %>
                </span>
              </div>

              <div class="d-flex align-items-center justify-content-between">
                <div class="ts-trip-avatars">
                  <% trip.users.limit(4).each do |member| %>
                    <span class="ts-mini-avatar" title="<%= member.name %>"><%= member.name.to_s.first.to_s.upcase %></span>
                  <% end %>
                  <% if trip.users.count > 4 %>
                    <span class="ts-mini-avatar">+<%= trip.users.count - 4 %></span>
                  <% end %>
                </div>
                <% if trip.creator == current_user %>
                  <span class="ts-chip ts-chip-primary"><i class="bi bi-star-fill"></i> Owner</span>
                <% end %>
              </div>

              <hr class="ts-divider">

              <div class="d-flex flex-wrap gap-2">
                <%= link_to trip_path(trip), class: "btn btn-sm btn-primary flex-fill" do %>
                  <i class="bi bi-eye me-1"></i> View
                <% end %>

                <% if trip.creator == current_user %>
                  <%= link_to edit_trip_path(trip), class: "btn btn-sm btn-light", title: "Edit trip" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>

                  <%= link_to trip_path(trip),
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this trip?" },
                        class: "btn btn-sm btn-light text-danger", title: "Delete trip" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="ts-card">
      <div class="ts-empty">
        <div class="ts-empty-icon"><i class="bi bi-airplane"></i></div>
        <h5>No trips yet</h5>
        <p>Create your first trip to start splitting expenses with your group.</p>
        <%= link_to new_trip_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i> Create a Trip
        <% end %>
      </div>
    </div>
  <% end %>

</div>
