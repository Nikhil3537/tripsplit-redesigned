<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "TripSplit — Split expenses effortlessly" %></title>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="TripSplit helps groups track shared expenses, split costs fairly, and settle up without the awkward math.">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/icon-192.png">

  <%= yield :head %>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Chart.js (dashboard analytics) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" defer></script>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

  <%= javascript_importmap_tags %>

  <!-- Avoid a flash of the wrong theme before tripsplit.js runs -->
  <script>
    (function () {
      var t = localStorage.getItem("ts-theme");
      if (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
      document.documentElement.setAttribute("data-bs-theme", t || "light");
    })();
  </script>
</head>

<body>

<div id="ts-topbar-progress" class="ts-topbar-progress"></div>

<!-- ==========================================================
     NAVBAR
     ========================================================== -->
<nav class="navbar navbar-expand-lg ts-navbar">
  <div class="container ts-shell">

    <!-- Mobile sidebar trigger -->
    <% if logged_in? %>
      <button class="ts-icon-btn d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#tsSidebar" aria-controls="tsSidebar" aria-label="Open menu">
        <i class="bi bi-list fs-5"></i>
      </button>
    <% end %>

    <%= link_to root_path, class: "ts-brand" do %>
      <span class="ts-brand-mark"><i class="bi bi-wallet2"></i></span>
      <span>TripSplit</span>
    <% end %>

    <div class="d-flex align-items-center gap-2 order-lg-3 ms-auto">

      <button type="button" class="ts-icon-btn" data-ts-theme-toggle aria-label="Toggle dark mode">
        <i class="bi bi-moon-stars-fill"></i>
      </button>

      <% if logged_in? %>

        <!-- Notifications -->
        <div class="dropdown">
          <button class="ts-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
            <i class="bi bi-bell-fill"></i>
            <% if @trip.present? && @trip.is_a?(Trip) && @trip.creator == current_user && @trip.join_requests.where(status: :pending).exists? %>
              <span class="ts-dot"></span>
            <% end %>
          </button>
          <div class="dropdown-menu dropdown-menu-end ts-notif-menu">
            <div class="p-3 border-bottom fw-bold">Notifications</div>
            <% if @trip.present? && @trip.is_a?(Trip) && @trip.creator == current_user && (pending = @trip.join_requests.where(status: :pending)).exists? %>
              <% pending.includes(:user).limit(5).each do |req| %>
                <div class="d-flex align-items-start gap-2 px-3 py-2 border-bottom">
                  <i class="bi bi-person-plus-fill text-primary mt-1"></i>
                  <div class="small">
                    <strong><%= req.user.name %></strong> wants to join <strong><%= @trip.name %></strong>.
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center text-muted py-4 small">
                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                No new notifications
              </div>
            <% end %>
          </div>
        </div>

        <!-- Profile dropdown -->
        <div class="dropdown">
          <button class="btn p-0 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="ts-avatar"><%= current_user.name.to_s.first.to_s.upcase %></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end ts-user-menu">
            <li class="px-2 py-2">
              <div class="fw-bold"><%= current_user.name %></div>
              <div class="small text-muted text-truncate"><%= current_user.email %></div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to root_path, class: "dropdown-item" do %><i class="bi bi-speedometer2"></i> Dashboard<% end %></li>
            <li><%= link_to trips_path, class: "dropdown-item" do %><i class="bi bi-compass"></i> My Trips<% end %></li>
            <li><%= link_to new_trip_path, class: "dropdown-item" do %><i class="bi bi-plus-circle"></i> New Trip<% end %></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to session_path, method: :delete, class: "dropdown-item text-danger border-0 bg-transparent w-100 text-start", form: { class: "m-0" } do %>
                <i class="bi bi-box-arrow-right"></i> Logout
              <% end %>
            </li>
          </ul>
        </div>

      <% else %>
        <%= link_to new_session_path, class: "btn btn-light btn-sm d-none d-sm-inline-flex" do %>
          <i class="bi bi-box-arrow-in-right me-1"></i> Login
        <% end %>
        <%= link_to new_user_path, class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-person-plus me-1"></i> Sign Up
        <% end %>
      <% end %>
    </div>

    <!-- Desktop nav links -->
    <% if logged_in? %>
      <ul class="navbar-nav mx-lg-4 d-none d-lg-flex flex-row gap-1 order-lg-2">
        <li class="nav-item">
          <%= link_to "Dashboard", root_path, class: "nav-link ts-nav-link", data: { "ts-nav-match": "/" } %>
        </li>
        <li class="nav-item">
          <%= link_to "My Trips", trips_path, class: "nav-link ts-nav-link", data: { "ts-nav-match": trips_path } %>
        </li>
        <li class="nav-item">
          <%= link_to new_trip_path, class: "nav-link ts-nav-link", data: { "ts-nav-match": new_trip_path } do %>
            <i class="bi bi-plus-lg"></i> New Trip
          <% end %>
        </li>
      </ul>
    <% end %>
  </div>
</nav>

<!-- Mobile offcanvas sidebar -->
<% if logged_in? %>
  <div class="offcanvas offcanvas-start ts-sidebar" tabindex="-1" id="tsSidebar" aria-labelledby="tsSidebarLabel">
    <div class="offcanvas-header">
      <span class="ts-brand" id="tsSidebarLabel">
        <span class="ts-brand-mark"><i class="bi bi-wallet2"></i></span>
        <span>TripSplit</span>
      </span>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <div class="d-flex align-items-center gap-3 mb-4 ts-soft-panel p-3">
        <span class="ts-avatar"><%= current_user.name.to_s.first.to_s.upcase %></span>
        <div class="text-truncate">
          <div class="fw-bold text-truncate"><%= current_user.name %></div>
          <div class="small text-muted text-truncate"><%= current_user.email %></div>
        </div>
      </div>

      <%= link_to root_path, class: "ts-sidebar-link" do %><i class="bi bi-speedometer2"></i> Dashboard<% end %>
      <%= link_to trips_path, class: "ts-sidebar-link" do %><i class="bi bi-compass"></i> My Trips<% end %>
      <%= link_to new_trip_path, class: "ts-sidebar-link" do %><i class="bi bi-plus-circle"></i> Create Trip<% end %>

      <hr class="ts-divider">

      <%= button_to session_path, method: :delete, class: "btn btn-outline-danger w-100", form: { class: "m-0" } do %>
        <i class="bi bi-box-arrow-right me-1"></i> Logout
      <% end %>
    </div>
  </div>
<% end %>

<!-- ==========================================================
     FLASH -> TOASTS
     ========================================================== -->
<% if notice %>
  <div class="d-none" data-ts-flash="<%= notice %>" data-ts-flash-type="success"></div>
<% end %>
<% if alert %>
  <div class="d-none" data-ts-flash="<%= alert %>" data-ts-flash-type="danger"></div>
<% end %>

<!-- ==========================================================
     PAGE CONTENT
     ========================================================== -->
<main>
  <%= yield %>
</main>

<!-- ==========================================================
     FLOATING ACTION BUTTON
     ========================================================== -->
<% if logged_in? %>
  <%= link_to new_trip_path, class: "ts-fab", aria: { label: "Create a new trip" } do %>
    <span class="ts-fab-label">New Trip</span>
    <i class="bi bi-plus-lg"></i>
  <% end %>
<% end %>

<!-- ==========================================================
     FOOTER
     ========================================================== -->
<footer class="ts-footer">
  <div class="container ts-shell">
    <div class="row g-4">
      <div class="col-12 col-md-4">
        <span class="ts-brand mb-2 d-inline-flex">
          <span class="ts-brand-mark"><i class="bi bi-wallet2"></i></span>
          <span>TripSplit</span>
        </span>
        <p class="text-muted small mt-2 mb-0">Split trip expenses fairly, track balances, and settle up — without the spreadsheet headache.</p>
      </div>
      <div class="col-6 col-md-2">
        <div class="fw-bold small text-uppercase text-muted mb-2">Product</div>
        <div class="d-flex flex-column gap-2 small">
          <%= link_to "Dashboard", logged_in? ? root_path : new_session_path %>
          <%= link_to "My Trips", logged_in? ? trips_path : new_session_path %>
          <%= link_to "New Trip", logged_in? ? new_trip_path : new_session_path %>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="fw-bold small text-uppercase text-muted mb-2">Company</div>
        <div class="d-flex flex-column gap-2 small">
          <a href="mailto:hello@tripsplit.app">Contact</a>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="fw-bold small text-uppercase text-muted mb-2">Account</div>
        <div class="d-flex flex-column gap-2 small">
          <% if logged_in? %>
            <%= link_to "Signed in as #{current_user.name}", root_path %>
          <% else %>
            <%= link_to "Login", new_session_path %>
            <%= link_to "Create account", new_user_path %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="ts-footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <span>&copy; <%= Time.current.year %> TripSplit. All rights reserved.</span>
      <span class="d-flex align-items-center gap-1"><i class="bi bi-shield-check"></i> Built for effortless group expenses</span>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<!-- Register Service Worker -->
<script>
if ("serviceWorker" in navigator) {
  window.addEventListener("load", function () {
    navigator.serviceWorker.register("/service-worker.js")
      .then(function(registration) {
        console.log("Service Worker registered:", registration.scope);
      })
      .catch(function(error) {
        console.log("Service Worker registration failed:", error);
      });
  });
}
</script>

</body>
</html>
