<% content_for :title, "Create Account — TripSplit" %>

<div class="container ts-shell ts-auth-wrap">
  <div class="row justify-content-center w-100 g-0">
    <div class="col-12 col-lg-10 col-xl-9">
      <div class="ts-auth-card row g-0 ts-fade-in">

        <div class="col-lg-5 d-none d-lg-flex ts-auth-side">
          <div class="ts-auth-side-content d-flex flex-column justify-content-between">
            <div>
              <span class="ts-brand text-white mb-4 d-inline-flex">
                <span class="ts-brand-mark bg-white bg-opacity-25"><i class="bi bi-wallet2"></i></span>
                <span>TripSplit</span>
              </span>
              <h2 class="text-white fw-bold mb-3">Join TripSplit.</h2>
              <p class="text-white-50">Create a free account and start splitting trip expenses with your friends in minutes.</p>
            </div>
            <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> Create unlimited trips
              </li>
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> Invite members with a shareable link
              </li>
              <li class="d-flex align-items-center gap-2 text-white-50">
                <i class="bi bi-check-circle-fill text-white"></i> Always know who owes what
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="ts-auth-form">
            <div class="mb-4">
              <h3 class="fw-bold mb-1">Create your account</h3>
              <p class="text-muted mb-0">It only takes a minute.</p>
            </div>

            <%= form_with model: @user do |form| %>

              <% if @user.errors.any? %>
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-4">
                  <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                  <div>
                    <strong><%= pluralize(@user.errors.count, "error") %> prevented this account from being created:</strong>
                    <ul class="mb-0 mt-1 ps-3">
                      <% @user.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="mb-3">
                <%= form.label :name, class: "form-label" %>
                <div class="ts-input-group">
                  <i class="bi bi-person ts-input-icon"></i>
                  <%= form.text_field :name, class: "form-control", placeholder: "Your full name", required: true, autofocus: true %>
                </div>
              </div>

              <div class="mb-3">
                <%= form.label :email, class: "form-label" %>
                <div class="ts-input-group">
                  <i class="bi bi-envelope ts-input-icon"></i>
                  <%= form.email_field :email, class: "form-control", placeholder: "you@example.com", required: true %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= form.label :password, class: "form-label" %>
                  <div class="ts-input-group">
                    <i class="bi bi-lock ts-input-icon"></i>
                    <%= form.password_field :password, class: "form-control", placeholder: "••••••••", required: true, id: "user_password_field" %>
                    <button type="button" class="ts-toggle-password" data-ts-toggle-password="#user_password_field" tabindex="-1" aria-label="Show password">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
                  <div class="ts-input-group">
                    <i class="bi bi-shield-lock ts-input-icon"></i>
                    <%= form.password_field :password_confirmation, class: "form-control", placeholder: "••••••••", required: true, id: "user_password_confirmation_field" %>
                    <button type="button" class="ts-toggle-password" data-ts-toggle-password="#user_password_confirmation_field" tabindex="-1" aria-label="Show password">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="d-grid mt-3">
                <%= form.submit "Create Account", class: "btn btn-primary btn-lg" %>
              </div>

            <% end %>

            <p class="text-center text-muted mt-4 mb-0">
              Already have an account?
              <%= link_to "Log in", new_session_path, class: "fw-bold text-decoration-none" %>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
